# Public URL of the application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Recommended identification for server-side Wikipedia API requests
WIKIPEDIA_USER_AGENT=ArtExplorer/1.0 (educational art discovery application)

# Yandex Cloud Translate credentials (optional; if omitted, original English texts are shown)
# YANDEX_TRANSLATE_API_KEY=
# YANDEX_TRANSLATE_FOLDER_ID=
# YANDEX_TRANSLATE_URL=https://translate.api.cloud.yandex.net/translate/v2/translate

# --- Optional overrides (used by e2e tests with the local mock server) ---
# AIC_API_URL=https://api.artic.edu/api/v1
# AIC_IIIF_URL=https://www.artic.edu/iiif/2
# CMA_API_URL=https://openaccess-api.clevelandart.org/api
# WIKIPEDIA_URL_TEMPLATE=https://{lang}.wikipedia.org
# EXTERNAL_API_TIMEOUT_MS=8000
